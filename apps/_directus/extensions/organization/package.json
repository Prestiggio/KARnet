{
	"name": "organization",
	"description": "Please enter a description for your extension",
	"icon": "extension",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-hook"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "hook",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.1",
		"@types/node": "^26.1.1",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@directus/sdk": "^23.0.0",
		"neo4j-driver": "^6.2.0",
		"puppeteer": "^25.3.0"
	}
}
