{
	"name": "directus-extension-song-search",
	"version": "1.0.0",
	"type": "module",
	"description": "Recherche de chansons dans Elasticsearch + pré-remplissage des champs (UI en React)",
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "interface",
				"name": "song-search",
				"source": "src/interface/index.ts"
			},
			{
				"type": "interface",
				"name": "song-chord",
				"source": "src/interface/chord.ts"
			},
			{
				"type": "endpoint",
				"name": "song-search-api",
				"source": "src/endpoint/index.ts"
			},
			{
				"type": "hook",
				"name": "song-search-sync",
				"source": "src/hook/index.ts"
			}
		],
		"host": "^10.10.0 || ^11.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "^13.0.0",
		"@directus/sdk": "^23.0.0",
		"@rollup/plugin-replace": "^6.0.0",
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"typescript": "^5.5.0",
		"vue": "^3.4.0"
	},
	"dependencies": {
		"@tonaljs/chord-detect": "^4.9.1",
		"react": "^18.3.0",
		"react-dom": "^18.3.0"
	}
}
