{
	"name": "persons-dedup",
	"description": "Vérification de doublon (Elasticsearch) avant création d'une personne",
	"icon": "extension",
	"version": "1.0.1",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "hook",
				"name": "persons-dedup-sync",
				"source": "src/hook/index.ts"
			},
			{
				"type": "hook",
				"name": "saints-dedup-sync",
				"source": "src/hook/saint.ts"
			},
			{
				"type": "endpoint",
				"name": "persons-dedup-api",
				"source": "src/endpoint/index.ts"
			},
			{
				"type": "endpoint",
				"name": "saints-dedup-api",
				"source": "src/endpoint/saint.ts"
			},
			{
				"type": "module",
				"name": "persons-dedup",
				"source": "src/module/index.ts"
			},
			{
				"type": "interface",
				"name": "persons-dedup-prefill-input",
				"source": "src/interface/index.ts"
			},
			{
				"type": "interface",
				"name": "saints-dedup-prefill-input",
				"source": "src/interface/saint.ts"
			}
		],
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.1",
		"@directus/sdk": "^23.0.0",
		"@tailwindcss/postcss": "^4.3.3",
		"autoprefixer": "^10.5.4",
		"postcss": "^8.5.25",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vue": "^3.5.40",
		"vue-router": "^4.4.0"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
		"neo4j-driver": "^6.2.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	}
}
